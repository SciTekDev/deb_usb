# Shared cluster settings, sourced by the other k8s scripts
K8S_VERSION="v1.33"
POD_CIDR="10.244.0.0/16"
CONTROL_PLANE_HOST="northwoods"

# Static addressing, used by 00-set-static-ip.sh
GATEWAY="10.0.0.1"
PREFIX=24
NETWORK_CIDR="10.0.0.0/$PREFIX"
DNS_SERVERS="10.0.0.1 8.8.8.8"
SEARCH_DOMAIN="dustyslate.com"

declare -A NODE_IPS=(
    [northwoods]=10.0.0.4
    [eastwoods]=10.0.0.6
    [westwoods]=10.0.0.8
)

# All four NIC addresses per node; the first is the cluster IP above
declare -A NODE_NIC_IPS=(
    [northwoods]="10.0.0.4 10.0.0.14 10.0.0.24 10.0.0.34"
    [eastwoods]="10.0.0.6 10.0.0.16 10.0.0.26 10.0.0.36"
    [westwoods]="10.0.0.8 10.0.0.18 10.0.0.28 10.0.0.38"
)

# Node role labels: storage, web, gpu
declare -A NODE_ROLES=(
    [northwoods]=storage
    [eastwoods]=web
    [westwoods]=gpu
)

CONTROL_PLANE_IP="${NODE_IPS[$CONTROL_PLANE_HOST]}"

# Exits unless this host is a known node and already has its static IP
require_node_ip() {
    local me ip
    me=$(hostname -s)
    ip="${NODE_IPS[$me]:-}"
    [[ -n "$ip" ]] || { echo "Hostname '$me' is not one of: ${!NODE_IPS[*]}"; exit 1; }
    ip -4 -o addr show | grep -q "inet $ip/" || {
        echo "$me does not have $ip assigned; run 00-set-static-ip.sh and reboot"
        exit 1
    }
}

# Exits unless this host has the given role (storage, web, gpu)
require_role() {
    local me
    me=$(hostname -s)
    [[ "${NODE_ROLES[$me]:-}" == "$1" ]] || { echo "$me is not a '$1' node"; exit 1; }
}
