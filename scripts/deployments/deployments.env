# Shared settings for the deployment scripts
source "$(dirname "${BASH_SOURCE[0]}")/../k8s/cluster.env"

DOMAIN="dustyslate.com"      # hostnames: gitlab.$DOMAIN, jenkins.$DOMAIN, rancher.$DOMAIN, kibana.$DOMAIN
INGRESS_IP="${NODE_IPS[eastwoods]}"  # point DNS or /etc/hosts for the hostnames here
NFS_SERVER="${NODE_IPS[northwoods]}"
NFS_PATH="/mnt/storage/k8s"  # created by k8s/06-setup-storage-node.sh
ELK_VERSION="8.17.0"
RETENTION_DAYS=14             # how long pod logs are kept (used by 06-elk-retention.sh)
ES_DATA_PATH="/var/lib/elasticsearch"  # local path on northwoods, outside the NFS exports
GITLAB_DATA_PATH="/srv/gitlab"         # local path on eastwoods
